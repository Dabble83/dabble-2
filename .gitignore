# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cursor-send local send log
docs/cursor-queue/.cursor-queue.log

# content edits in flight (don't commit half-edited Word docs;
# regenerate /content-export/pages/ from manifest.json with `npm run content:export`)
/content-export/edits-inbox/*
!/content-export/edits-inbox/.gitkeep
next.config.tmp.mjs
~$*.docx
.env*.local
